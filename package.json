{
  "name": "veritas-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd pages && wrangler pages dev -c wrangler.jsonc -c ../worker/wrangler.local.jsonc --ip 127.0.0.1 --port 8794",
    "build": "npm run build:worker && npm run build:pages",
    "test": "node --test test/*.test.js",
    "test:journey": "node scripts/journey.mjs",
    "predev": "node scripts/index-references.mjs",
    "prebuild": "node scripts/index-references.mjs",
    "build:worker": "cd worker && wrangler deploy --dry-run --outdir ../dist/worker",
    "build:pages": "wrangler pages functions build pages/functions --outdir dist/pages",
    "pretest": "node scripts/index-references.mjs",
    "references:refresh": "node scripts/index-references.mjs --refresh",
    "model:local": "node scripts/local-model.mjs",
    "eval": "npm --prefix evals run evaluate",
    "preeval": "node scripts/index-references.mjs",
    "review:local": "node scripts/review-local.mjs",
    "eval:setup": "cd evals && npm ci --legacy-peer-deps --include=optional --no-fund"
  },
  "devDependencies": {
    "pdfjs-dist": "6.5.438",
    "playwright": "1.60.0",
    "wrangler": "4.164.0"
  }
}
